## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Ignore debug logs
[Dd]ebug/
[Dd]ebugPublic/
*.log
*.tlog

# Visual Studio cache/options
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# DotCover
*.dotCover

# Build artifacts
*.dll
*.exe
*.app
*.appx
*.msix
*.msixupload
*.apk
*.aab

# Debug/Release folders
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Publish
.publish/
out/
artifacts/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# NuGet
*.nupkg
*.snupkg
*.nuspec
*.psmdcp
.nuget/
packages/
*.nuget.props
*.nuget.targets

# Entity Framework
Migrations/

# SQLite (comment out if you want DB in repo)
*.db
*.sqlite

# Logs
*.log
*.tlog

# Test results
[Tt]est[Rr]esult*/
[Tt]est[Rr]esults*/
*.trx
*.coverage
*.coveragexml

# Others
*.cache
*.pdb
*.mdb
*.opendb
*.VC.db
*.vscode/

# OS files
.DS_Store
Thumbs.db
desktop.ini
